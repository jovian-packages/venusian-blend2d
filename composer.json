{
  "name": "jovian/venusian-blend2d",
  "description": "Blend2D framebuffer, rasterization, raycasting and painting drivers for Venusian Topside, through ext-blend2d.",
  "version": "0.11.0",
  "type": "library",
  "keywords": [
    "framework",
    "venusian",
    "topside",
    "rasterization",
    "rasterizer",
    "painting",
    "thorvg"
  ],
  "license": "MIT",
  "homepage": "https://venusian.projectsaturnstudios.com/ecosystem/jovian/venusian-blend2d/0.11.x",
  "support": {
    "issues": "https://github.com/jovian-packages/venusian-blend2d/issues",
    "source": "https://github.com/jovian-packages/venusian-blend2d"
  },
  "authors": [
    {
      "name": "Angel Gonzalez",
      "email": "angel@projectsaturnstudios.com"
    }
  ],
  "require": {
    "php": "~8.4.27||^8.5.12",
    "ext-blend2d": "^0.11.0",
    "venusian-voyager/contracts": "^0.11.0",
    "venusian-surface/rendering": "^0.11.0",
    "venusian-surface/toolkits": "^0.11.0"
  },
  "require-dev": {
    "pestphp/pest": "^4"
  },
  "autoload": {
    "psr-4": {
      "Jovian\\Rendering\\Blend2D\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Jovian\\Rendering\\Blend2D\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "extra": {
    "branch-alias": {
      "dev-main": "0.11.x-dev"
    },
    "venusian": {
      "providers": [
        "Jovian\\Rendering\\Blend2D\\Providers\\VenusianBlend2DServiceProvider"
      ]
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
